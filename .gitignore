# Raw COCO data (large, downloaded separately)
data/val2017/
data/annotations_trainval2017/
data/coco_rag_data/train2017_subset/

# Generated images (large, rebuilt by the scripts)
!data/**/*.json

# Large binary files
*.zip
*.npy
*.faiss
*.index

# Track small JSON reports and manifests
!data/**/*.json

# Ignore again after the rule above (it would re-include these)
data/coco_rag_data/captions_metadata_*.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/